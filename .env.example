# Copy to .env and edit. Every setting is optional.

# Public URL that phones use, e.g. your Cloudflare tunnel hostname.
# Leave it unset and the QR code points at this computer's LAN address (same-wifi play).
# PUBLIC_URL=https://party.example.com

# Fix the host PIN (6 digits) and room code (4 letters) instead of random ones.
# HOST_PIN=123456
# ROOM_CODE=FAMS

# Server port (default 3000) and where photos + the saved game live (default ./data).
# PORT=3000
# DATA_DIR=data

# Name of your named Cloudflare tunnel for `npm run tunnel` (default: party).
# TUNNEL_NAME=party
